    {
      "nativeToken": "content",
      "valueShape": null,
      "typicalUse": "Composition of another content item, inline or referenced.",
      "editorBehavior": "Accepts any content type unless limited: allowedTypes lists permitted content types, restrictedTypes lists excluded content types, and restrictedTypes takes priority over allowedTypes. Nested blocks are limited to eight levels, counted across inline blocks in content areas, component and content properties, arrays of components and Visual Builder sections; a shared block or shared section counts as one level, and its own contents are checked when it is saved. The whole item is checked on every save, so content nested past a limit cannot be saved, even after an unrelated edit, until its nesting is reduced; a REST request that exceeds a limit returns 400 Bad Request with the path of the field.",
      "storageShape": null,
      "deliveryShape": null,
