{
  "name": "cms-field-vocabulary",
  "version": "0.0.0-development",
  "description": "Official-source-backed CMS field vocabularies and deterministic coding-agent contracts",
  "type": "module",
  "private": false,
  "license": "MIT",
  "author": "Joe Fusco",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JFusco/cms-field-vocabulary.git"
  },
  "homepage": "https://github.com/JFusco/cms-field-vocabulary#readme",
  "bugs": {
    "url": "https://github.com/JFusco/cms-field-vocabulary/issues"
  },
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=24.14.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "cms-field-vocabulary": "bin/cms-field-vocabulary.mjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./catalog": "./catalog/catalog.json",
    "./catalog/profiles/*": "./catalog/profiles/*.json",
    "./definitions": {
      "types": "./dist/definitions.d.ts",
      "import": "./dist/definitions.js",
      "require": "./dist/definitions.cjs"
    },
    "./definitions.json": "./definitions/rendering-operations.json",
    "./schema/*": "./schemas/*.schema.json",
    "./profiles/*": "./profiles/consumers/*.json",
    "./profiles/agent/*": "./profiles/agent/*.json",
    "./profiles/consumer/*": "./profiles/consumers/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "catalog/catalog.json",
    "catalog/profiles/",
    "definitions/",
    "dist/",
    "docs/platforms/",
    "profiles/",
    "schemas/",
    "sources/evidence-locators.json",
    "sources/official-sources.json",
    "sources.lock.json",
    "CHANGELOG.md",
    "LICENSE",
    "OPERATING.md",
    "README.md",
    "SECURITY.md"
  ],
  "keywords": [
    "cms",
    "contentful",
    "contentstack",
    "optimizely",
    "sitecore",
    "wordpress",
    "content-modeling",
    "ai-agents"
  ],
  "scripts": {
    "prepare": "husky",
    "clean": "node scripts/clean.mjs",
    "catalog:build": "node scripts/build-catalog.mjs",
    "catalog:check": "node scripts/build-catalog.mjs --check",
    "types:build": "tsup src/index.ts src/definitions.ts --format esm,cjs --dts --clean --out-dir dist",
    "build": "pnpm run catalog:build && pnpm run types:build",
    "validate": "node scripts/validate.mjs",
    "context:check": "node scripts/check-context-budget.mjs",
    "context:update": "node scripts/check-context-budget.mjs --update",
    "test": "node --test tests/*.test.mjs",
    "test:packed": "node scripts/verify-packed-consumer.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "pnpm run lint:fix",
    "format:check": "pnpm run lint",
    "lint:staged": "lint-staged",
    "lint:commit": "commitlint --config commitlint.config.cjs",
    "commit": "ai-commit run",
    "pr:create": "ai-pr",
    "release:dry": "semantic-release --dry-run",
    "release:preflight": "node scripts/check-release-commit.cjs",
    "release:preflight:selftest": "node scripts/check-release-commit.selftest.cjs",
    "sources:scan:index": "node scripts/source-scan.mjs --mode index",
    "sources:scan:full": "node scripts/source-scan.mjs --mode full",
    "sources:review": "node scripts/source-review.mjs",
    "wiki:check": "node scripts/wiki/check.cjs",
    "graph:build": "node scripts/wiki/build-graph.cjs",
    "graph:check": "node scripts/wiki/build-graph.cjs --check",
    "verify:push": "pnpm run validate && pnpm run catalog:check && pnpm run types:build && pnpm run test && pnpm run context:check && pnpm run wiki:check",
    "verify:ci": "pnpm run lint && pnpm run release:preflight && pnpm run verify:push",
    "prepack": "pnpm run validate && pnpm run catalog:check && pnpm run types:build"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@eslint/js": "10.0.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.8",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "24.10.1",
    "@verndale/ai-commit": "2.7.0",
    "@verndale/ai-pr": "1.3.5",
    "ajv": "8.17.1",
    "conventional-changelog-conventionalcommits": "9.1.0",
    "eslint": "10.0.2",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "semantic-release": "25.0.2",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts}": "eslint --fix --max-warnings=0 --no-warn-ignored",
    "*.json": "node scripts/validate-staged-json.mjs"
  }
}
