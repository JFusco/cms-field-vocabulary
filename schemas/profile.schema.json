{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JFusco/cms-field-vocabulary/schemas/profile.schema.json",
  "title": "CMS field vocabulary profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "platform",
    "product",
    "version",
    "surface",
    "transport",
    "extensibility",
    "sourceIds",
    "fields"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
    "platform": {
      "enum": [
        "contentful",
        "contentstack",
        "optimizely-saas",
        "optimizely-paas",
        "sitecore-ai",
        "sitecore-on-prem",
        "wordpress"
      ]
    },
    "product": { "type": "string", "minLength": 1 },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "label"],
      "properties": {
        "mode": { "enum": ["pinned", "rolling"] },
        "label": { "type": "string", "minLength": 1 },
        "sdk": { "type": "string", "minLength": 1 }
      }
    },
    "surface": { "enum": ["authoring", "management", "storage", "delivery", "sdk"] },
    "transport": { "type": "string", "minLength": 1 },
    "extensibility": { "enum": ["closed-at-profile", "discoverable", "open"] },
    "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/field" }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "locator"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 }
      }
    },
    "textClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value", "evidence"],
      "properties": {
        "status": { "enum": ["documented", "undocumented"] },
        "value": { "type": ["string", "null"] },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "valueShapeClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value", "evidence"],
      "properties": {
        "status": { "enum": ["documented", "undocumented"] },
        "value": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "nullable"],
              "properties": {
                "kind": {
                  "enum": ["string", "boolean", "integer", "number", "datetime", "object", "array", "reference", "rich-text", "binary", "unknown"]
                },
                "nullable": { "type": "boolean" },
                "valuePath": { "type": "string" },
                "itemKind": { "type": "string" },
                "members": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "type": "string" }
                }
              }
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "renderingOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operation", "authority", "prohibitionCodes"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
        "operation": {
          "enum": ["direct", "branch", "format", "component", "anchor", "asset", "resolved-content", "reference", "iterate", "pass-through"]
        },
        "authority": { "enum": ["official", "contract-derived", "consumer-policy"] },
        "valuePath": { "type": "string" },
        "rendererId": { "type": "string" },
        "props": { "type": "object", "additionalProperties": { "type": "string" } },
        "attributes": { "type": "object", "additionalProperties": { "type": "string" } },
        "editTarget": { "enum": ["self", "wrapper", "container", "none"] },
        "stableKeyPaths": { "type": "array", "items": { "type": "string" } },
        "stableKeyFallback": { "enum": ["index-primitive-or-no-identity"] },
        "selection": { "$ref": "#/$defs/renderingSelection" },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "equals", "attributes"],
            "properties": {
              "path": { "type": "string" },
              "equals": { "type": "string" },
              "attributes": { "type": "object", "additionalProperties": { "type": "string" } }
            }
          }
        },
        "nullHandling": { "enum": ["preserve", "undefined-attribute", "branch", "not-applicable"] },
        "formatStrategy": { "enum": ["shared-util"] },
        "constraintKeys": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "prohibitionCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "apply-edit-attribute-per-item",
              "apply-preview-attributes-per-item",
              "apply-preview-attributes-to-richtext-renderer",
              "assume-binary-string-url",
              "assume-password-encrypted",
              "assume-undocumented-shape",
              "coerce-checkbox-with-generic-truthiness",
              "coerce-rich-text-to-html-string",
              "coerce-rich-text-to-plain-string",
              "construct-media-url-manually",
              "discard-editable-field-shape",
              "discard-field-metadata",
              "escape-rich-text-as-plain-text",
              "flatten-asset-reference",
              "flatten-content-reference",
              "flatten-file-field",
              "flatten-link-field",
              "flatten-link-object",
              "flatten-list",
              "flatten-resolved-content",
              "flatten-reference",
              "flatten-structured-value",
              "flatten-url-object",
              "invent-fallback-value",
              "omit-component-content-type",
              "pass-content-reference-to-optimizely-component",
              "pass-url-to-content-reference-resolver",
              "render-secret-value",
              "replace-sdk-field-with-raw-html",
              "replace-sdk-field-with-raw-value",
              "treat-html-source-as-richtext-type"
            ]
          }
        },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "claimRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "claims.nativeType",
              "claims.valueShape",
              "claims.typicalUse",
              "claims.editorBehavior",
              "claims.storageShape",
              "claims.deliveryShape"
            ]
          }
        },
        "policyId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" }
      }
    },
    "renderingSelection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["discriminator", "equals"],
          "properties": {
            "discriminator": { "const": "content-reference-usage" },
            "equals": { "enum": ["link", "media"] }
          }
        }
      ]
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nativeToken", "evidence"],
      "properties": {
        "nativeToken": { "type": "string", "minLength": 1 },
        "requires": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalId", "nativeToken", "origin", "applicability", "claims", "renderingOperations", "formats"],
      "properties": {
        "canonicalId": { "type": "string", "pattern": "^[a-z0-9][A-Za-z0-9._-]+$" },
        "nativeToken": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "origin": { "const": "native" },
        "applicability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profileId", "product", "version", "surface", "transport"],
          "properties": {
            "profileId": { "type": "string", "minLength": 1 },
            "product": { "type": "string", "minLength": 1 },
            "version": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "label"],
              "properties": {
                "mode": { "enum": ["pinned", "rolling"] },
                "label": { "type": "string", "minLength": 1 },
                "sdk": { "type": "string", "minLength": 1 }
              }
            },
            "surface": { "enum": ["authoring", "management", "storage", "delivery", "sdk"] },
            "transport": { "type": "string", "minLength": 1 }
          }
        },
        "claims": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nativeType", "valueShape", "typicalUse", "editorBehavior", "storageShape", "deliveryShape"],
          "properties": {
            "nativeType": { "$ref": "#/$defs/textClaim" },
            "valueShape": { "$ref": "#/$defs/valueShapeClaim" },
            "typicalUse": { "$ref": "#/$defs/textClaim" },
            "editorBehavior": { "$ref": "#/$defs/textClaim" },
            "storageShape": { "$ref": "#/$defs/textClaim" },
            "deliveryShape": { "$ref": "#/$defs/textClaim" }
          }
        },
        "renderingOperations": {
          "type": "array",
          "items": { "$ref": "#/$defs/renderingOperation" }
        },
        "formats": {
          "type": "array",
          "items": { "$ref": "#/$defs/format" }
        }
      }
    }
  }
}
