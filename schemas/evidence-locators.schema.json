{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JFusco/cms-field-vocabulary/schemas/evidence-locators.schema.json",
  "title": "Reviewed claim-evidence locators",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sources"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "locators"],
        "properties": {
          "sourceId": { "type": "string", "minLength": 1 },
          "locators": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["locator"],
              "properties": {
                "locator": { "type": "string", "minLength": 1 },
                "tokens": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    }
  }
}
