{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JFusco/cms-field-vocabulary/schemas/rendering-definitions.schema.json",
  "title": "Closed rendering-operation vocabulary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operationKinds", "authorities", "claimRefs", "formatStrategies", "selectionDiscriminators", "prohibitionCodes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "operationKinds": {
      "const": ["direct", "branch", "format", "component", "anchor", "asset", "resolved-content", "reference", "iterate", "pass-through"]
    },
    "authorities": { "const": ["official", "contract-derived", "consumer-policy"] },
    "claimRefs": {
      "const": ["claims.nativeType", "claims.valueShape", "claims.typicalUse", "claims.editorBehavior", "claims.storageShape", "claims.deliveryShape"]
    },
    "formatStrategies": { "const": ["shared-util"] },
    "selectionDiscriminators": {
      "const": {
        "content-reference-usage": ["link", "media"]
      }
    },
    "prohibitionCodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    }
  }
}
