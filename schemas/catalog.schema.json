{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JFusco/cms-field-vocabulary/schemas/catalog.schema.json",
  "title": "Compiled CMS field vocabulary catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogVersion", "sourceLockDigest", "platforms", "profiles"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogVersion": { "const": 1 },
    "sourceLockDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["contentful", "contentstack", "optimizely-saas", "optimizely-paas", "sitecore-ai", "sitecore-on-prem", "wordpress"]
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "profile.schema.json" }
    }
  }
}
